#!/usr/bin/env python3
"""
keyd-nav-indicator: Visual overlay and state indicator for the keyd 'nav' layer on Linux / KDE Plasma (Wayland & X11).
Displays a sleek, click-through, non-focus-stealing HUD when nav mode is active,
and maintains /tmp/keyd-nav for panel widgets/scripts.
"""

import glob
import os
import signal
import subprocess
import sys
import threading
import time

STATE_FILE = "/tmp/keyd-nav"


def ensure_display_env():
    """Ensure WAYLAND_DISPLAY / GDK_BACKEND are set even if started early by systemd."""
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    os.environ["XDG_RUNTIME_DIR"] = runtime_dir
    if not os.environ.get("WAYLAND_DISPLAY"):
        sockets = sorted(glob.glob(os.path.join(runtime_dir, "wayland-[0-9]*")))
        sockets = [s for s in sockets if not s.endswith(".lock")]
        if sockets:
            os.environ["WAYLAND_DISPLAY"] = os.path.basename(sockets[0])
    if os.environ.get("WAYLAND_DISPLAY"):
        os.environ.setdefault("GDK_BACKEND", "wayland")


def update_state_file(active: bool):
    try:
        with open(STATE_FILE, "w") as f:
            if active:
                f.write("### NAV\n")
            else:
                f.truncate(0)
    except Exception as e:
        sys.stderr.write(f"Error updating {STATE_FILE}: {e}\n")


def create_gui_indicator():
    import cairo
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, Gdk, GLib

    try:
        gi.require_version("GtkLayerShell", "0.1")
        from gi.repository import GtkLayerShell
        has_layer_shell = True
    except (ValueError, ImportError):
        has_layer_shell = False

    class NavOverlay(Gtk.Window):
        def __init__(self):
            super().__init__(type=Gtk.WindowType.TOPLEVEL)
            self.set_title("keyd-nav-indicator")
            self.set_role("indicator")

            # Style provider
            provider = Gtk.CssProvider()
            css = b"""
            window {
                background-color: transparent;
            }
            #nav-pill {
                background-color: rgba(22, 22, 22, 0.90);
                border: 1px solid rgba(77, 147, 117, 0.85);
                border-radius: 6px;
                padding: 4px 12px;
            }
            #nav-text {
                color: #55ba8a;
                font-size: 13px;
                font-weight: bold;
                font-family: monospace;
            }
            """
            provider.load_from_data(css)
            Gtk.StyleContext.add_provider_for_screen(
                Gdk.Screen.get_default(),
                provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
            )

            # Container & Label
            box = Gtk.Box()
            box.set_name("nav-pill")
            label = Gtk.Label(label="### NAV")
            label.set_name("nav-text")
            box.pack_start(label, True, True, 0)
            self.add(box)

            # Wayland layer-shell configuration
            if has_layer_shell and GtkLayerShell.is_supported():
                GtkLayerShell.init_for_window(self)
                GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
                GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
                GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.LEFT, True)
                GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, 16)
                GtkLayerShell.set_margin(self, GtkLayerShell.Edge.LEFT, 16)
                if hasattr(GtkLayerShell, "set_keyboard_mode"):
                    GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.NONE)
                else:
                    GtkLayerShell.set_keyboard_interactivity(self, False)
            else:
                # X11 fallback
                self.set_decorated(False)
                self.set_keep_above(True)
                self.set_skip_taskbar_hint(True)
                self.set_skip_pager_hint(True)
                self.set_accept_focus(False)
                self.move(16, 16)

            # Transparent click-through region so mouse clicks pass through
            self.connect("realize", self._make_click_through)
            update_state_file(False)

        def _make_click_through(self, widget):
            try:
                window = widget.get_window()
                if window:
                    window.input_shape_combine_region(cairo.Region())
            except Exception:
                pass

        def set_nav(self, active: bool):
            update_state_file(active)
            if active:
                GLib.idle_add(self.show_all)
            else:
                GLib.idle_add(self.hide)

        def run(self):
            Gtk.main()

    return NavOverlay()


def notify_permission_error():
    try:
        subprocess.run(
            [
                "notify-send",
                "-u",
                "critical",
                "keyd-nav-indicator",
                "Cannot access keyd socket.\nRun: sudo usermod -aG keyd $USER\nand re-login.",
            ],
            timeout=2,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        pass


def listen_keyd(indicator):
    has_notified = False
    while True:
        try:
            # Must use stdbuf -oL so keyd flushes stdout immediately over a pipe
            proc = subprocess.Popen(
                ["stdbuf", "-oL", "keyd", "listen"],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                bufsize=1,
            )

            first_line = proc.stdout.readline()
            if not first_line and proc.poll() is not None:
                err = proc.stderr.read()
                sys.stderr.write(f"[keyd-nav-indicator] keyd listen error: {err}\n")
                if ("socket" in err.lower() or "permission" in err.lower()) and not has_notified:
                    notify_permission_error()
                    has_notified = True
                time.sleep(10)
                continue

            has_notified = False

            if first_line:
                first_clean = first_line.strip()
                if first_clean.startswith("+nav"):
                    indicator.set_nav(True)
                elif first_clean.startswith("-nav"):
                    indicator.set_nav(False)

            for line in proc.stdout:
                line = line.strip()
                if line.startswith("+nav"):
                    indicator.set_nav(True)
                elif line.startswith("-nav"):
                    indicator.set_nav(False)

            proc.wait()
        except FileNotFoundError:
            sys.stderr.write("[keyd-nav-indicator] 'stdbuf' or 'keyd' binary not found in PATH.\n")
            time.sleep(10)
        except Exception as e:
            sys.stderr.write(f"[keyd-nav-indicator] Exception: {e}\n")
            time.sleep(5)


def cleanup(*args):
    update_state_file(False)
    sys.exit(0)


def main():
    signal.signal(signal.SIGINT, cleanup)
    signal.signal(signal.SIGTERM, cleanup)

    ensure_display_env()

    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk

    if not Gtk.init_check()[0]:
        sys.stderr.write("[keyd-nav-indicator] Display not ready yet, exiting for systemd retry.\n")
        sys.exit(1)

    indicator = create_gui_indicator()

    listener_thread = threading.Thread(target=listen_keyd, args=(indicator,), daemon=True)
    listener_thread.start()

    indicator.run()


if __name__ == "__main__":
    main()
