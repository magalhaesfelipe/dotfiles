// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)

{
	"reduce_motion": "on",
	"gutter": {
		"line_numbers": true,
		"min_line_number_digits": 4,
	},
	"relative_line_numbers": "disabled",
	"git": {
		"inline_blame": {
			"enabled": false,
		},
	},
	"centered_layout": {
		"left_padding": 0.25,
		"right_padding": 0.0,
	},
	"icon_theme": "File Icons",
	"buffer_font_weight": 500.0,
	"terminal": {
		"env": {
			"MSYS": "\"disable_pcon\"",
		},
		"line_height": {
			"custom": 1.2,
		},
		"copy_on_select": true,
	},
	"preview_tabs": {
		"enabled": false,
		"enable_preview_from_file_finder": false,
	},
	"status_bar": {
		"experimental.show": false,
	},
	"minimap": {
		"current_line_highlight": "all",
  "thumb_border": "none",
		"show": "never",
		"thumb": "hover",
		"max_width_columns": 115,
	},
	"cursor_shape": "block",
	"autosave": "on_window_change",
	"buffer_font_family": "JetBrains Mono",
	"file_types": {
		"css": ["*.micro"],
	},
	"format_on_save": "on",
	"preferred_line_length": 110,
	"hard_tabs": true,
	"tab_size": 2,
	"base_keymap": "VSCode",
	"session": {
		"trust_all_worktrees": true,
	},
	"vim_mode": false,
	"ui_font_size": 16,
	"buffer_font_size": 15,
	"theme": {
		"mode": "system",
		"light": "One Light",
		"dark": "Catppuccin Frappé",
	},
}
